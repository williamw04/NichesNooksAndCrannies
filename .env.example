# LLM Provider (choose one)
# Option 1: OpenAI directly
OPENAI_API_KEY=sk-...

# Option 2: OpenRouter (recommended - cheaper, free models available)
OPENROUTER_API_KEY=sk-or-...
# Set this to use OpenRouter instead of OpenAI
LLM_PROVIDER=openrouter  # or "openai"

# Free models on OpenRouter:
# - stepfun/step-3.5-flash:free
# - meta-llama/llama-3.2-3b-instruct:free
# - qwen/qwen-2-7b-instruct:free

# Cheap models on OpenRouter:
# - openai/gpt-4o-mini ($0.15/1M input, $0.60/1M output)
# - anthropic/claude-3.5-sonnet ($3/1M input, $15/1M output)
# - meta-llama/llama-3.1-8b-instruct ($0.055/1M input, $0.055/1M output)

# Other APIs
SERPAPI_KEY=...
GOOGLE_MAPS_API_KEY=...
YELP_API_KEY=...

# Reddit (not needed - using .json endpoint)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=hidden-gems/0.1.0

# Rate Limiting
REQUESTS_PER_MINUTE=60
REDDIT_RATE_LIMIT=60

# Output
OUTPUT_DIR=./data/output
MAX_LOCATIONS=50