{
  "name": "tiktok-scraper",
  "version": "2.0.0",
  "description": "TikTok location scraper with social validation scoring and AI extraction",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/tui.ts",
    "scrape": "tsx src/cli.ts",
    "scrape:example": "tsx src/cli.ts --input example-input.json",
    "tui": "tsx src/tui.ts",
    "dev": "tsx src/index.ts",
    "serve": "npx serve -l 8000",
    "test": "tsx test/test-scrape.ts",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "debug": "tsx test/debug.ts",
    "debug:google": "tsx test/debug-google.ts",
    "debug:search": "tsx test/debug-search.ts",
    "debug:video": "tsx test/debug-video.ts",
    "debug:subtitles": "tsx test/debug-subtitles.ts",
    "debug:captions": "tsx test/debug-captions.ts",
    "debug:discover": "tsx test/debug-discover-structure.ts",
    "debug:urls": "tsx test/debug-discover-urls.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@supabase/supabase-js": "^2.103.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
